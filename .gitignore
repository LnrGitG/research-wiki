# PDF binaries — keep only extracted markdown
raw/papers/Workpapers/
*.pdf

# Local/archive material not for mobile sync
_archive/

# Obsidian
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
# Obsidian community plugins — синхронизировать вручную, тяжёлые данные не в git
.obsidian/plugins/*/*.min.js

# Large Rosstat RAR archives (extracted contents tracked, RARs in GCS only)
raw/rosstat/socioeconomic_regions/*.rar
raw/rosstat/socioeconomic_regions/fed_okr_*.rar

# ── YC Object Storage heavy data (local = symlink to yc-wiki or cached copy) ──
# raw/ is a symlink to ~/yc-wiki/raw/ (YC bucket wiki-research via rclone mount)
# All heavy raw data lives in YC Object Storage, not in git
raw/

# Large SQLite databases (downloaded on-demand via yc_sync.ensure_db)
data/rosstat_construction.db
data/regions_panel.db
data/cbr_lending.db
data/fns_tochno_sectors.db
rosreestr_deals.db

# DB cleanup archive: JSONL backups of removed DOM.RF marginal blocks (GCS only)
data/archive/*.jsonl

# FNS tochno-st xlsx files (GCS only)
raw/fns/tochno-st/by_section/

# Rosstat regions collection (GCS only)
raw/rosstat/regions_collection_102/*.parquet
raw/rosstat/regions_collection_102/*.zip
scripts/__pycache__/

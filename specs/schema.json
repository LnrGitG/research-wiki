{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec",
  "type": "object",
  "required": ["name", "version", "kind", "model", "target"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "version": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["model", "slice", "filter"]},
    "model": {"enum": ["ols", "fe", "re", "midas", "bridge", "midasml", "ardl", "ar"]},
    "target": {
      "type": "object",
      "required": ["metric_code", "frequency"],
      "properties": {
        "metric_code": {"type": "string"},
        "metric_id": {"type": "integer"},
        "frequency": {"enum": ["m", "q", "a"]},
        "region_id": {"type": "integer", "default": 1}
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric_code"],
        "properties": {
          "metric_code": {"type": "string"},
          "metric_id": {"type": "integer"},
          "lags": {"type": "array", "items": {"type": "integer"}},
          "transform": {"enum": ["level", "yoy", "log", "diff"]},
          "frequency": {"enum": ["m", "q", "a"]}
        }
      }
    },
    "filters": {
      "type": "object",
      "properties": {
        "frequency": {"enum": ["m", "q", "a"]},
        "region_id": {"type": "integer"},
        "sub_dimension": {"type": "string"},
        "period_start": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
        "period_end": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
        "release": {"enum": ["final", "first", "any"]}
      }
    },
    "sample": {
      "type": "object",
      "properties": {
        "start": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
        "end": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"}
      }
    },
    "oos": {"type": "object", "properties": {"start": {"type": "string"}}},
    "notes": {"type": "string"}
  }
}